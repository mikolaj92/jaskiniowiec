{
  "name": "jaskiniowiec",
  "description": "Polski tryb ultra-zwięzłej komunikacji. Tnie zbędne słowa, zachowuje pełną treść techniczną.",
  "author": {
    "name": "Mikołaj Maciąg",
    "url": "https://github.com/mikolaj92"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/jaskiniowiec-activate.js\"",
            "timeout": 5,
            "statusMessage": "Ładowanie trybu jaskiniowca..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/jaskiniowiec-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Śledzenie trybu jaskiniowca..."
          }
        ]
      }
    ]
  }
}
